#!/usr/bin/env bash

set -euo pipefail

if find src -type f -name mod.rs -print -quit | grep -q .; then
    echo "Rust modules must use foo.rs with a foo directory."
    exit 1
fi

if grep -rEn 'tracing::(trace|debug|info|warn|error)!' src --include='*.rs'; then
    echo "Import tracing macros before calling them."
    exit 1
fi

if grep -rEn '#\[tokio::main\([^]]*current_thread' src --include='*.rs'; then
    echo "Use the default multithreaded Tokio runtime."
    exit 1
fi

added_comments=$(
    git diff --cached --find-renames --unified=0 -- '*.rs' |
        awk '/^\+\+\+/{next} /^\+[[:space:]]*\/\/[\/!]?/ {print}'
)

if printf '%s\n' "$added_comments" | grep -n ';'; then
    echo "Rust comments must not contain semicolons."
    exit 1
fi

if printf '%s\n' "$added_comments" | LC_ALL=C grep -n '[^	 -~]'; then
    echo "Rust comments must use plain ASCII text."
    exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$staged" ] && printf '%s\n' "$staged" | tr '\n' '\0' |
    xargs -0 grep -nEI '\bS[A-Z2-7]{55}\b|suiprivkey1[a-z0-9]+|\bs(Ed)?[1-9A-HJ-NP-Za-km-z]{27,30}\b'; then
    echo "Possible key material in staged files. Move it outside the repo."
    exit 1
fi
