# Chain identity
CHAIN=arc-11
ENV=testnet

# Chain metadata
CHAIN_NAME="Arc Testnet"
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.network
TOKEN_SYMBOL=USDC
DECIMALS=18
EXPLORER_NAME="Arc Testnet Explorer"
EXPLORER_URL="https://testnet.arcscan.app/"

# Axelar config
TARGET_JSON=../axelar-contract-deployments/axelar-chains-config/info/testnet.json
MNEMONIC="..."
# Hardened deployments: optional separate admin; defaults to MNEMONIC.
# Legacy deployments: required if MNEMONIC does not control the configured admin.
# MULTISIG_PROVER_MNEMONIC="..."

# Deployment keys
SALT=v1.0.13
DEPLOYER_PRIVATE_KEY=0x...
GATEWAY_DEPLOYER_PRIVATE_KEY=0x...
GAS_SERVICE_DEPLOYER_PRIVATE_KEY=0x...

# ITS (required for the full `axe deploy` pipeline)
ITS_DEPLOYER_PRIVATE_KEY=0x...
ITS_SALT=v2.2.0
ITS_PROXY_SALT=v1.0.0

# Alchemy (optional — used by `axe decode tx` for reliable archive RPCs)
# ALCHEMY_TOKEN=your_token_here

# Load-test RPC overrides (optional — equivalent to --source-rpc / --destination-rpc).
# Useful when the chain config's default endpoint is rate-limited or down.
# SOURCE_RPC=https://...
# DESTINATION_RPC=https://...

# Intent EVM RPC overrides (optional). Each is validated against its chain ID;
# an unhealthy override falls back to the matching chains-config RPC.
# SEP_RPC_URL=https://...
# ARB_SEPOLIA_RPC_URL=https://...
# BASE_SEPOLIA_RPC_URL=https://...
# FUJI_RPC_URL=https://...

# Axelar Cosmos LCD/RPC overrides (optional — used by the cross-chain verifier).
# Defaults to the URL from the chains config (often imperator.co), with built-in
# fallbacks to lavenderfive/publicnode/cosmos.directory if those flap.
# AXELAR_LCD_URL=https://rest.lavenderfive.com/axelar
# AXELAR_RPC_URL=https://axelar-rpc.publicnode.com

# Deployment settings (required for new deployments; no JSON plan needed).
# Owners/operator are EVM addresses. Verifiers are discovered at activation.
# Prover admin is derived from MULTISIG_PROVER_MNEMONIC, or MNEMONIC if unset.
# ITS/factory owners and gateway operator are set during the original deployments.
# AXELAR_CHAIN_ID=axelar-testnet-lisbon-3
# GATEWAY_OWNER=0x...
# OPERATORS_OWNER=0x...
# GAS_SERVICE_OWNER=0x...
# ITS_OWNER=0x...
# FACTORY_OWNER=0x...
# GATEWAY_OPERATOR=0x...
# Maximum gas/fee allowances per signer, in base units (wei / uaxl on testnet).
# EVM_GAS_BUDGET=50000000000000000
# COSMOS_FEE_BUDGET=100000000
# Amount for EACH reward pool, in the configured Cosmos fee denomination.
# REWARD_AMOUNT=100000000
# VOTING_THRESHOLD=2/3
# SIGNING_THRESHOLD=2/3
# BLOCK_EXPIRY=50
# CONFIRMATION_HEIGHT=1
# Deployment receipt wait: inclusion counts as 1; use N confirmations or finalized.
# Optional: new runs default to 1; resumes inherit the journal unless overridden.
# Independent of CONFIRMATION_HEIGHT, which configures verifier voting.
# EVM_CONFIRMATIONS=1
